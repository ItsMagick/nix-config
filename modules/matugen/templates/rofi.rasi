/* Generated by matugen — DO NOT hand-edit, edit config.rasi instead */
* {
    /* --- Accent tokens (buttons, borders, highlights) --- */
    mtg-accent:           {{colors.primary.default.hex}};
    mtg-on-accent:        {{colors.on_primary.default.hex}};
    mtg-accent-container: {{colors.primary_container.default.hex}};
    mtg-accent-soft:      {{colors.primary.default.hex}}55;
    mtg-button-grad:      linear-gradient(to right, {{colors.primary_container.default.hex}}, {{colors.primary.default.hex}});

    /* --- Surface tokens (window + panels, layered for contrast) --- */
    mtg-bg:               {{colors.surface_container_lowest.default.hex}};
    mtg-bg-alpha:         {{colors.surface_container_lowest.default.hex}}f2;
    mtg-surface-1:        {{colors.surface_container_low.default.hex}};
    mtg-surface-1-alpha:  {{colors.surface_container_low.default.hex}}b3;
    mtg-surface-2:        {{colors.surface_container_high.default.hex}};

    /* --- Text tokens --- */
    mtg-on-surface:       {{colors.on_surface.default.hex}};
    mtg-on-surface-var:   {{colors.on_surface_variant.default.hex}};
    mtg-outline:          {{colors.outline_variant.default.hex}};

    /* --- Error tokens --- */
    mtg-error:            {{colors.error.default.hex}};
    mtg-on-error:         {{colors.on_error.default.hex}};
}