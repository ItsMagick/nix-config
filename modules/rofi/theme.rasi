@import "colors.rasi" * {
  mauve: #cba6f7;
  active-grad: linear-gradient(to bottom, #45475a, #313244);

  width: 1200px;
  font: "JetBrainsMono Nerd Font 11";
}

element-text,
element-icon,
mode-switcher {
  background-color: inherit;
  text-color: inherit;
}

window {
  height: 600px;
  background-color: @mtg-bg-alpha;
  border: 2px;
  border-color: @mtg-outline;
  border-radius: 20px;
  transparency: "real";
}

mainbox {
  background-color: transparent;
  children:
    [ input-area,
    listview];
  orientation: horizontal;
  spacing: 20px;
  padding: 30px;
}

input-area {
  children:
    [ inputbar,
    mode-switcher,
    dummy];
  background-color: transparent;
  orientation: vertical;
  expand: false;
  width: 220px;
  spacing: 15px;
}

inputbar {
  children: [ entry];
  background-color: @mtg-surface-1-alpha;
  border-radius: 12px;
  padding: 10px;
  orientation: horizontal;
  border: 1px;
  border-color: @mtg-accent-soft;
}
entry {
  padding: 4px;
  text-color: @mtg-on-surface;
  background-color: transparent;
  placeholder: "Search";
  placeholder-color: @mtg-on-surface-var;
  font: "JetBrainsMono Nerd Font Bold 11";
  horizontal-align: 0;
}

mode-switcher {
  orientation: vertical;
  spacing: 8px;
  background-color: transparent;
}

button {
  padding: 12px;
  background-color: @mtg-surface-1;
  text-color: @mtg-on-surface-var;
  vertical-align: 0.5;
  horizontal-align: 0;
  border-radius: 10px;
  cursor: pointer;
}
button selected {
  background-image: @mtg-button-grad;
  text-color: @mtg-on-accent;
  font-weight: bold;
  border: 0px;
}

dummy {
  expand: true;
  background-color: transparent;
}

listview {
  border: 0px;
  margin: 0px;
  padding: 0px;
  background-color: transparent;
  columns: 6;
  lines: 6;
  spacing: 12px;
  flow: horizontal;
  fixed-columns: true;
}

element {
  orientation: vertical;
  children:
    [ element-icon,
    element-text];
  padding: 15px 5px;
  spacing: 6px;
  background-color: transparent;
  border-radius: 14px;
  text-color: @mtg-on-surface;
  cursor: pointer;
  border: 1px;
  border-color: transparent;
}

element selected {
  background-image: @active-grad;
  text-color: @mauve;
  border: 1px;
  border-color: @mauve;
  border-radius: 14px;
}
element-icon {
  size: 42px;
  horizontal-align: 0.5;
  vertical-align: 0.5;
  cursor: inherit;
}
element-text {
  text-color: inherit;
  horizontal-align: 0.5;
  vertical-align: 0.5;
  cursor: inherit;
  font: "JetBrainsMono Nerd Font 10";
}

error-message {
  background-color: @mtg-bg;
  border: 1px;
  border-color: @mtg-error;
  border-radius: 12px;
  padding: 20px;
  text-color: @mtg-error;
}